# StreamGlass Environment Configuration

# Backend port when running locally (default: 8000)
PORT=8000

# Frontend URL for CORS in production (Vercel automatically sets domains)
FRONTEND_URL=https://your-deployment.vercel.app

# Optional: Turso cloud database credentials (if enabling distributed cloud writes in production)
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-auth-token
